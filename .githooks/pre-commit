#!/usr/bin/env bash
# Eden pre-commit secret guard. This repo is PUBLIC.
# Blocks commits that add secret-looking content or forbidden paths.
# Enable:  git config core.hooksPath .githooks
# Audit a range before pushing:  .githooks/pre-commit --range origin/main..HEAD
set -euo pipefail

if [ "${1:-}" = "--range" ]; then
    DIFF=$(git log -p --format='commit %H%n%s%n%b' "$2")
    PATHS=$(git log --name-only --format= "$2" | sort -u)
    MODE="range $2"
else
    DIFF=$(git diff --cached -U0)
    PATHS=$(git diff --cached --name-only)
    MODE="staged changes"
fi

fail=0
say() { printf '\033[1;31mBLOCKED\033[0m %s\n' "$*"; fail=1; }

# 1. Paths that must never be committed.
while read -r p; do
    [ -z "$p" ] && continue
    case "$p" in
        .secrets/*|*/data/config.json|*.pem|*.key|*.p12|*.env|*/.env.*) say "forbidden path: $p" ;;
    esac
    case "$p" in *.example.json|*.sample|*.template) ;; esac
done <<< "$PATHS"

# Only added lines (and commit messages in range mode) are scanned.
ADDED=$(printf '%s\n' "$DIFF" | grep -E '^\+[^+]|^commit |^[^+-]' | grep -vE '^\+\+\+ ' || true)

# 2. Credential-looking assignments with a real-looking value.
PLACEHOLDER='YOUR_|FILL_ME_IN|CHANGE_ME|<[a-z_-]+>|example|placeholder|contents of|pick a long|\$\{|\$[A-Z_]+|%s|redacted|password_file|passwd /etc|setPassword\(|\.password|password\]|password\)|"password": *""'
if hits=$(printf '%s\n' "$ADDED" | grep -nEi '(password|passwd|secret|token|api[_-]?key|auth)["'"'"']? *[:=] *["'"'"'][^"'"'"']{8,}["'"'"']' | grep -vEi "$PLACEHOLDER"); [ -n "$hits" ]; then
    say "credential-looking value:"; printf '%s\n' "$hits" | head -5
fi

# 3. Private keys, Tailscale IPs, MAC addresses, WiFi SSID assignments.
check() { local label=$1 re=$2; if hits=$(printf '%s\n' "$ADDED" | grep -nE -e "$re"); [ -n "$hits" ]; then say "$label:"; printf '%s\n' "$hits" | head -5; fi; }
check "private key"        '-----BEGIN [A-Z ]*PRIVATE KEY-----'
check "Tailscale IP (100.64-127.x)" '\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b'
check "MAC address"        '\b([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b'
if hits=$(printf '%s\n' "$ADDED" | grep -nE '"ssid": *"[^"]{2,}"' | grep -vE 'YOUR_|FILL_ME_IN|CHANGE_ME'); [ -n "$hits" ]; then
    say "SSID assignment:"; printf '%s\n' "$hits" | head -5
fi

# 4. Location words in commit messages/docs (public repo — keep home location out).
LOC="Grand[ ]Junction|Colo[r]ado|, C[O]\\b"
check "location (home city)" "\\b($LOC)"

if [ $fail -eq 1 ]; then
    echo
    echo "Eden is a PUBLIC repo. Fix the above (move to .secrets/ or config.json, use placeholders, reword) and retry."
    echo "Scanned: $MODE"
    exit 1
fi
exit 0
